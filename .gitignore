# Local environments and package caches
envs/
.conda/
.cache/
.config/
models/

# Datasets and generated mapping artifacts. Keep only the small final JSON
# files at their original paths; RGB/depth data, detections and point clouds
# remain ignored.
data/**
!data/Replica/
data/Replica/**
!data/Replica/room0/
data/Replica/room0/**
!data/Replica/room0/exps/
data/Replica/room0/exps/**
!data/Replica/room0/exps/smoke_mapping_stride20_gpu0_cached/
data/Replica/room0/exps/smoke_mapping_stride20_gpu0_cached/**
!data/Replica/room0/exps/smoke_mapping_stride20_gpu0_cached/*.json
!data/Replica/room0/exps/room0_mapping_stride10/
data/Replica/room0/exps/room0_mapping_stride10/**
!data/Replica/room0/exps/room0_mapping_stride10/*.json
**/outputs/
*.pkl
*.pkl.gz
*.rrd

# Deprecated Habitat bundles created before the canonical
# results/HabitatMP3D/<sequence>/<run>/map_bundle layout.
results/HabitatMP3D/*_smoke/map_bundle/

# Model weights and binary checkpoints
*.pt
*.pth
*.ckpt
*.safetensors
*.bin

# Python/build artifacts
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Credentials and local overrides
.env
.env.*
!.env.example
*.pem
*.key
credentials*
secrets*

# Runtime links and editor files
latest_pcd_save
.DS_Store
*.swp
